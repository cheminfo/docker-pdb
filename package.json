{
  "name": "pdb-quickview",
  "version": "1.1.1",
  "description": "Searchable mirror of the wwPDB with precomputed PyMol thumbnails, served from CouchDB behind nginx.",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/pdb-quickview.git"
  },
  "homepage": "https://github.com/cheminfo/pdb-quickview#readme",
  "bugs": {
    "url": "https://github.com/cheminfo/pdb-quickview/issues"
  },
  "keywords": [
    "pdb",
    "pdb-parser",
    "pymol",
    "thumbnails",
    "couchdb"
  ],
  "author": "Daniel Kostro",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^5.0.0",
    "debug": "^4.4.0",
    "glob": "^11.0.0",
    "gm": "^1.25.1",
    "nano": "^10.1.4",
    "openchemlib": "^9.22.1",
    "openchemlib-utils": "^8.15.1",
    "pino": "^10.3.1",
    "postgrator": "^8.0.0",
    "rsync": "^0.6.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "eslint-config-cheminfo": "^14.0.0",
    "prettier": "^3.6.2",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "cron": "node src/cron.js",
    "dev": "docker compose -f compose.dev.yaml up -d && COUCHDB_HOST=127.0.0.1 DATA_DIR=./data node --watch --env-file-if-exists=.env src/dev.js",
    "dev:down": "docker compose -f compose.dev.yaml down",
    "eslint": "eslint src",
    "eslint-fix": "eslint src --fix",
    "prettier": "prettier --check src",
    "prettier-write": "prettier --write src",
    "rebuild": "node src/rebuild.js",
    "seed": "node src/seed.js",
    "seed-ccd": "node src/ccd/seedCCD.js",
    "test": "npm run test-only && npm run eslint && npm run prettier",
    "test-only": "vitest run --coverage",
    "update": "node src/update.js"
  }
}
