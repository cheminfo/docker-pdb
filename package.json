{
  "name": "docker-pdb",
  "version": "1.0.1",
  "description": "Sync of the official PDB database into CouchDB. The database is searchable for properties like number of residues, residue percentages, molecular weight, etc.",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/docker-pdb.git"
  },
  "homepage": "https://github.com/cheminfo/docker-pdb#readme",
  "bugs": {
    "url": "https://github.com/cheminfo/docker-pdb/issues"
  },
  "keywords": [
    "pdb",
    "pdb-parser",
    "couchdb"
  ],
  "author": "Daniel Kostro",
  "license": "MIT",
  "dependencies": {
    "debug": "^4.4.0",
    "glob": "^11.0.0",
    "gm": "^1.25.1",
    "nano": "^10.1.4",
    "rsync": "^0.6.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "eslint-config-cheminfo": "^14.0.0",
    "prettier": "^3.6.2",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "cron": "node src/cron.js",
    "dev": "node --watch --env-file-if-exists=.env src/cron.js",
    "eslint": "eslint src",
    "eslint-fix": "eslint src --fix",
    "prettier": "prettier --check src",
    "prettier-write": "prettier --write src",
    "rebuild": "node src/rebuild.js",
    "test": "npm run test-only && npm run eslint && npm run prettier",
    "test-only": "vitest run --coverage",
    "update": "node src/update.js"
  }
}
