# Deployment mode: uncomment exactly ONE line to choose how the service is
# exposed. With none uncommented, docker compose uses compose.yaml by default.
# COMPOSE_FILE=compose.yaml             # port-published (publishes PUBLIC_PORT on the host)
# COMPOSE_FILE=compose.traefik.yaml     # behind a Traefik reverse proxy
# COMPOSE_FILE=compose.cloudflared.yaml # behind a Cloudflare Tunnel (no published port)

# Local port pdb-api publishes on the host (compose.yaml only). Same value as
# the in-container PORT below, so the service is reachable on 31015 either way.
PUBLIC_PORT=31015

# debug() namespaces. Use '*' to log everything, or e.g. 'pdb-sync:*'
DEBUG=*

# Cloudflare Tunnel token (compose.cloudflared.yaml only)
# TUNNEL_TOKEN=

# --- Admin authentication (settings page) ---
#
# On first startup, if the credentials table is empty and both vars are set,
# the username/password are hashed and seeded into SQLite. Subsequent logins
# and password changes operate against the DB — env vars are ignored after
# the initial seed. Omit both to leave the settings page unprotected.
#
# Generate a random secret with:
#   openssl rand -hex 32
COOKIE_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Local development overrides (npm run dev) ---

# Root for on-disk data (sqlite + rsynced .gz tree). Defaults to /app/data
# inside the container; npm run dev points it at ./data.
# DATA_DIR=./data

# Address/port the Fastify API (npm run api / npm run dev) binds to.
# Defaults: 0.0.0.0:31015 (derived from the project creation date).
# HOST=127.0.0.1
# PORT=31015

# Set to 1 to also run the pymol-dependent tests locally. Default: skipped.
# HAS_PYMOL=1

# --- PyMol render pool (node-pdb-sync container) ---

# Maximum simultaneous PyMol child processes (applies globally across the
# rsync path and the on-demand repair endpoint combined).  A hard cap of 8
# is enforced in code regardless of this value.
#
# Default auto-detection formula: min(8, max(1, floor(cpus / 2))).
#   2-core host  → 1   process
#   4-core host  → 2   processes
#   8-core host  → 4   processes
#  16-core host  → 8   processes (max)
#
# Each PyMol child uses ~500 MB RSS; at the default cap of 8 that is ~4 GB
# peak, well within the 16 GB container limit below.
# PYMOL_CONCURRENCY=4

# Memory cap applied by docker compose to the node-pdb-sync container.
# 16 GB covers up to 8 simultaneous PyMol renders (≈ 500 MB each) plus
# headroom for Node, rsync, and chokidar.
PYMOL_MEMORY_LIMIT=16g
