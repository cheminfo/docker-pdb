# Local port the nginx proxy publishes on the host (compose.example.yaml only)
NGINX_PORT=12345

# debug() namespaces. Use '*' to log everything, or e.g. 'pdb-sync:*'
DEBUG=*

# Cloudflare Tunnel token (compose.example.cloudflared.yaml only)
# TUNNEL_TOKEN=

# --- Local development overrides (npm run dev / npm run dev:backend) ---

# Root for on-disk data (sqlite + rsynced .gz tree). Defaults to /app/data
# inside the container; npm run dev:backend points it at ./data.
# DATA_DIR=./data

# Number of .ent.gz files src/dev.js ingests on startup. Default: 20.
# DEV_SEED_LIMIT=20

# Address/port the standalone Fastify API (npm run api / src/api/server.js)
# binds to. Defaults: 0.0.0.0:3000.
# HOST=127.0.0.1
# PORT=3000

# Set to 1 to also run the pymol-dependent tests locally. Default: skipped.
# HAS_PYMOL=1
