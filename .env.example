# Local port pdb-api publishes on the host (compose.example.yaml only).
PUBLIC_PORT=12345

# debug() namespaces. Use '*' to log everything, or e.g. 'pdb-sync:*'
DEBUG=*

# Cloudflare Tunnel token (compose.example.cloudflared.yaml only)
# TUNNEL_TOKEN=

# --- Local development overrides (npm run dev) ---

# Root for on-disk data (sqlite + rsynced .gz tree). Defaults to /app/data
# inside the container; npm run dev points it at ./data.
# DATA_DIR=./data

# Address/port the Fastify API (npm run api / npm run dev) binds to.
# Defaults: 0.0.0.0:3000.
# HOST=127.0.0.1
# PORT=3000

# Set to 1 to also run the pymol-dependent tests locally. Default: skipped.
# HAS_PYMOL=1
