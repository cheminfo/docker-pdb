{
  "name": "pdb-quickview-frontend",
  "version": "0.0.0",
  "description": "React + Vite homepage and statistics dashboard for pdb-quickview.",
  "type": "module",
  "private": true,
  "dependencies": {
    "@blueprintjs/core": "^6.12.1",
    "@blueprintjs/icons": "^6.9.1",
    "@codemirror/lang-json": "^6.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@uiw/react-codemirror": "^4.25.9",
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "molstar": "^5.9.0",
    "monaco-editor": "^0.55.1",
    "openchemlib": "^9.22.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-mf": "^3.1.1",
    "react-ocl": "^8.7.1",
    "react-router": "^7.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@zakodium/tsconfig": "^1.0.5",
    "eslint": "^9.39.4",
    "eslint-config-cheminfo-react": "^20.0.1",
    "eslint-config-cheminfo-typescript": "^22.0.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.3"
  },
  "scripts": {
    "build": "npm run check-types && vite build",
    "check-types": "tsc --noEmit",
    "clean": "rimraf ../nginx/www/assets ../nginx/www/index.html",
    "dev": "vite",
    "eslint": "eslint src",
    "eslint-fix": "eslint src --fix",
    "preview": "vite preview",
    "prettier": "prettier --check src",
    "prettier-write": "prettier --write src",
    "test": "npm run check-types && npm run eslint && npm run prettier",
    "test-e2e": "playwright test",
    "test-e2e-ui": "playwright test --ui"
  }
}
